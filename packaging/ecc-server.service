[Unit]
Description=ECC-Server, the chat-safety classifier host for Module-ECC
# docker.service: when `listen` is a Docker bridge address, the bridge exists once Docker has started.
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ecc-server
Group=ecc-server
ExecStart=/usr/bin/ecc-server run -config /etc/ecc-server/config.toml
# The W&B and Bedrock API keys `ecc-server wandb login` and `ecc-server bedrock login` encrypted into
# /etc/credstore.encrypted. Named without a path, a credential is searched for in the credential stores and skipped
# when missing, so the service starts without either key.
LoadCredentialEncrypted=ecc-server.wandb-api-key
LoadCredentialEncrypted=ecc-server.bedrock-api-key
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ecc-server

[Install]
WantedBy=multi-user.target
