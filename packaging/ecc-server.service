[Unit]
Description=ECC-Server, the chat-safety classifier host for Module-ECC
After=network-online.target
Wants=network-online.target

[Service]
User=ecc-server
Group=ecc-server
ExecStart=/usr/bin/ecc-server run -config /etc/ecc-server/config.toml
# The W&B API key `ecc-server wandb login` encrypted into /etc/credstore.encrypted. Named without a path, the
# credential is searched for in the credential stores and skipped when missing, so the service starts without a key.
LoadCredentialEncrypted=ecc-server.wandb-api-key
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ecc-server

[Install]
WantedBy=multi-user.target
