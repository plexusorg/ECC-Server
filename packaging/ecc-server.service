[Unit]
Description=ECC-Server, the chat-safety classifier host for Module-ECC
After=network-online.target
Wants=network-online.target

[Service]
User=ecc-server
Group=ecc-server
ExecStart=/usr/bin/ecc-server run -config /etc/ecc-server/config.toml
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ecc-server

[Install]
WantedBy=multi-user.target
